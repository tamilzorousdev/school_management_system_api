NODE_ENV=development
HOST=::
PORT=3000
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=
PUBLIC_BASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=telematics
DB_SSL=false
DB_POOL_SIZE=10
DB_MIGRATE_ON_START=true
SEED_ON_START=true

JWT_ACCESS_SECRET=generate-48-random-bytes-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=3600
REFRESH_TTL_DAYS=30

AUTH_PROVIDER=local
CENTRAL_AUTH_URL=http://auth-service-host:3002/api/auth
CENTRAL_AUTH_TIMEOUT_MS=8000
AUTH_EMAIL_DOMAIN=school.example.com
CENTRAL_AUTH_TENANT_ID=YOUR_AUTH_TENANT_ID
OTP_MODE=test
OTP_TEST=false

SMS_DRIVER=log

NOTIFY_KAFKA_BROKER=
NOTIFY_KAFKA_USER=
NOTIFY_KAFKA_PASSWORD=
NOTIFY_KAFKA_SSL=false
NOTIFY_KAFKA_TOPIC=notifications
NOTIFY_KAFKA_CLIENT_ID=school-api
NOTIFY_TENANT_ID=
NOTIFY_TEMPLATE_PREFIX=school_
NOTIFY_KAFKA_LOG=false

PUSH_DRIVER=off
CALL_PUSH_DRIVER=
FIREBASE_CREDENTIALS_FILE=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
FILE_MAX_MB=10
FILE_URL_TTL_SECONDS=3600
FILE_SIGNING_SECRET=generate-48-random-bytes-at-least-32-characters
QR_SIGNING_SECRET=generate-48-random-bytes-at-least-32-characters
DATA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
BIOMETRIC_WEBHOOK_KEY=
VIRUS_SCAN=off

QUEUE_DRIVER=memory
QUEUE_MAX_RETRIES=3

TELEMATICS_API_URL=http://localhost:3001/api/v1
TELEMATICS_API_KEY=paste-one-key-from-API_KEYS-in-telematics-service-.env
TELEMATICS_TIMEOUT_MS=5000

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=900
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_REST_URL=https://api.sd-rtn.com
AGORA_WEBHOOK_SECRET=
TELEMATICS_WEBHOOK_SECRET=same-value-as-TRIP_WEBHOOK_SECRET-in-telematics-service-.env
